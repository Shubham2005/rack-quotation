        sFittingRate: activeSRate,
        totalSlottedPlates,
        wFittingCost,
        wFittingRate: activeWRate,
        totalWallChannels,
        rentCost: activeRent,
      },
      grandTotal,
      hasOverrides,
      enrichedCart,
    };
  }, [
